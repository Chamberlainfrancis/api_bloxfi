// BloxFi API — Prisma schema
// Phase 0: minimal schema; models added in feature phases.
//
// Connection URL is configured in prisma.config.ts (root). Run Prisma commands from project root.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Placeholder for Phase 0; real models added in Feature 1+
model SchemaVersion {
  id String @id @default(uuid())
}

// Inbound LP webhooks audit (POST /api/v1/webhooks). Purged after retention (see webhookRetention job).
model WebhookInboundLog {
  id           String   @id @default(uuid())
  receivedAt   DateTime @default(now())
  /**
   * Truncated raw JSON body for storage caps.
   */
  rawBody      String   @db.Text
  /**
   * invalid_buffer | bad_signature | bad_json | bad_schema | processed | handler_error
   */
  outcome      String
  eventType    String?
  eventId      String?
  payload      Json?
  errorMessage String?  @db.Text

  @@index([receivedAt])
}

// Outbound partner webhooks (POST PARTNER_WEBHOOK_URL). Audit only — not a retry outbox.
// HMAC secret is never stored. Purged after retention (see webhookRetention job).
model WebhookOutboundLog {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  eventId      String
  eventType    String
  payload      Json
  rawBody      String    @db.Text
  destination  String?
  /**
   * pending | skipped_no_url | skipped_no_secret | delivered | failed
   */
  outcome      String
  attempts     Int       @default(0)
  httpStatus   Int?
  errorMessage String?   @db.Text
  deliveredAt  DateTime?

  @@index([createdAt])
  @@index([eventId])
  @@index([eventType])
  @@index([outcome])
}

/**
 * First-seen idempotency key per inbound webhook delivery (Palremit may retry).
 */
model WebhookDedupe {
  id        String   @id @default(uuid())
  provider  String
  dedupeKey String   @unique
  createdAt DateTime @default(now())
}

// --- Feature 1: User Creation & KYB (spec §1) ---

enum UserStatus {
  active
  inactive
  suspended
}

enum KYBStatusEnum {
  not_started
  incomplete
  under_review
  approved
  rejected
  suspended
}

model User {
  id                    String        @id @default(uuid())
  type                  String        @default("business")
  status                UserStatus    @default(active)
  businessInfo          Json // BusinessInfo shape; unique normalized email also enforced via DB indexes (see migrations)
  registeredAddress     Json // Address shape
  legalRepresentative   Json // LegalRepresentative shape
  metadata              Json?
  /**
   * Palremit Liquidity `channel_user_id` from §5.1; reused for §5.2 addresses (offramp).
   */
  palremitChannelUserId String?
  /**
   * POST /users idempotency key (requestId header).
   */
  creationRequestId     String?       @unique
  /**
   * Normalized businessInfo.email: lower(trim). Unique at DB + app layer.
   */
  businessEmailNorm     String?       @unique
  kybStatus             KYBStatusEnum @default(not_started)
  approvedRails         String[]      @default([])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  kybInfo           KybInfo?
  kybSubmissions    KybSubmission[]
  kybRailStatuses   KybRailStatus[]
  kybDocuments      KybDocument[]
  externalWallets   ExternalWallet[]
  accounts          Account[]
  onramps           Onramp[]
  offramps          Offramp[]
  highValueRequests HighValueRequest[]
  businessWallet    BusinessWallet?
}

model KybInfo {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessDetails  Json? // BusinessDetails shape
  beneficialOwners Json? // BeneficialOwner[] shape
  directors        Json? // Director[] shape
  updatedAt        DateTime @updatedAt
}

model KybSubmission {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rails                   String[] // e.g. ["USD", "EUR", "GBP"]
  priority                String? // e.g. "standard"
  status                  String // e.g. "under_review"
  submittedAt             DateTime  @default(now())
  estimatedCompletionDate DateTime?

  @@index([userId])
}

model KybRailStatus {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rail         String // e.g. "USD", "EUR"
  status       String // approved, under_review, etc.
  approvedAt   DateTime?
  submittedAt  DateTime?
  capabilities String[]  @default([]) // e.g. ["onramp", "offramp"]

  @@unique([userId, rail])
  @@index([userId])
}

// --- Feature 2: File Upload & KYB Documents (spec §1.4, §1.5) ---

model File {
  id          String   @id @default(uuid())
  filename    String // original filename
  size        Int // bytes
  mimeType    String // application/pdf, image/jpeg, image/png
  storagePath String // S3 object key (e.g. uploads/uuid_filename.pdf)
  uploadedAt  DateTime @default(now())

  kybDocuments KybDocument[]
}

model KybDocument {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  type       String // CERTIFICATE_OF_INCORPORATION, DIRECTOR_ID, etc.
  subType    String? // e.g. PASSPORT for DIRECTOR_ID
  status     String   @default("pending_review") // pending_review, approved, rejected
  metadata   Json? // issuedCountry, issueDate, expiryDate, documentNumber, ownerName
  uploadedAt DateTime @default(now())

  @@index([userId])
  @@index([fileId])
}

// --- Feature 3: External Wallets (spec §2) ---

model ExternalWallet {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String // blockchain address
  /**
   * Optional chain-specific tag / memo (e.g. XRP destination tag) for withdrawals.
   */
  memo        String?
  /**
   * Chain/network label provided by client (string). Do not validate against DB; validate at LP boundary.
   */
  chain       String
  name        String
  referenceId String // client reference for idempotency/correlation
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? // null until first update

  @@unique([userId, address, chain])
  @@index([userId])
  @@index([userId, createdAt])
}

// --- Feature 4: Accounts / Fiat (spec §3) ---

model Account {
  id                            String   @id @default(uuid())
  userId                        String
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  railType                      String // 'onramp' | 'offramp'
  currency                      String? // was non-nullable; onramp rows don't have a payout currency
  paymentRail                   String? // corridor destinationType (local_bank, wire, etc.); unused for onramp rail
  accountType                   String // free-form corridor label
  accountHolder                 Json // AccountHolder shape
  /**
   * Palremit corridor + canonical destination; API `details` is derived from this at read time. Offramp only.
   */
  providerPayout                Json? // was non-nullable; NULL for onramp rows (no payout destination)
  /**
   * SwipeLux customer id (cus_*) once known. Onramp only.
   */
  swipeluxCustomerId            String?
  /**
   * 'pending_import' | 'approved' | 'rejected' | 'failed'. Onramp only.
   */
  kycImportStatus               String?
  /**
   * Onramp-only idempotency key (POST /beneficiaries requestId). Offramp rows leave this null and
   * keep relying on idempotencyMiddleware's Redis lock as today.
   */
  creationRequestId             String?  @unique
  /**
   * Onramp SOF questionnaire answers (field name → value).
   */
  sofQuestionnaire              Json?
  /**
   * S3 object key for copied source-of-funds document (onramp).
   */
  sourceOfFundsDocumentPath     String?
  /**
   * Onramp extras (e.g. Graph identity `documents`).
   */
  metadata                      Json?
  /**
   * Graph (etc.) named-VA issuance: pending | active | failed. Onramp only.
   */
  providerIssuanceStatus        String?
  /**
   * Orchestrator provisioned-account id when issuance was started.
   */
  provisionedAccountId          String?
  /**
   * Fiat deposit instructions once providerIssuanceStatus=active.
   */
  depositDetails                Json?
  /**
   * Last issuance failure message when providerIssuanceStatus=failed.
   */
  providerIssuanceFailureReason String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([userId])
  @@index([userId, railType])
  @@index([userId, accountType])
  @@index([userId, currency])
  @@index([userId, createdAt])
  @@index([provisionedAccountId])
  @@index([providerIssuanceStatus])
}

// --- Feature 5: Onramp (spec §4) ---

enum OnrampStatusEnum {
  CREATED
  AWAITING_FUNDS
  FIAT_PENDING
  FIAT_PROCESSED
  CRYPTO_INITIATED
  CRYPTO_PENDING
  COMPLETED
  FIAT_FAILED
  FIAT_RETURNED
  CRYPTO_FAILED
  EXPIRED
}

model Onramp {
  id               String           @id @default(uuid())
  requestId        String           @unique // idempotency
  /**
   * BloxFi primary transaction id (ON-…); sent to Palremit; echoed as webhook data.txnRef
   */
  txnRef           String?          @unique
  /**
   * Palremit / channel identifiers for audit (fiat deposit id, withdrawal ref, etc.)
   */
  providerRefs     Json?
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           OnrampStatusEnum @default(CREATED)
  source           Json // OnrampSource shape
  destination      Json // OnrampDestination shape
  quoteInformation Json // QuoteInformation shape
  depositInfo      Json? // DepositInfo shape (when CREATED)
  receipt          Json? // Receipt shape (when COMPLETED)
  fees             Json? // OnrampFees shape
  profit           Json? // PalremitProfit shape — rate-spread profit (separate from fees)
  developerFee     Json? // legacy { amount, currency } — prefer fees.platformFee
  failedReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

// --- Feature 6: Offramp (spec §5) ---

enum OfframpStatusEnum {
  CREATED
  AWAITING_CRYPTO
  CRYPTO_PENDING
  CRYPTO_RECEIVED
  CRYPTO_CONFIRMED
  PROCESSING_FEE
  FEE_PROCESSED
  FIAT_INITIATED
  FIAT_PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  CRYPTO_FAILED
  FIAT_FAILED
  EXPIRED
}

model Offramp {
  id                  String            @id @default(uuid())
  requestId           String            @unique // idempotency
  /**
   * BloxFi primary transaction id (OFF-…); Palremit fiat withdrawal reference; echoed as webhook data.txnRef
   */
  txnRef              String?           @unique
  /**
   * Palremit / channel identifiers for audit
   */
  providerRefs        Json?
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              OfframpStatusEnum @default(CREATED)
  source              Json // OfframpSource shape (crypto)
  destination         Json // OfframpDestination shape (fiat)
  rateInformation     Json // RateInformation shape
  depositInstructions Json? // DepositInstructions (where to send crypto)
  timeline            Json? // Timeline shape
  fees                Json? // OfframpFees shape
  profit              Json? // PalremitProfit shape — rate-spread profit (separate from fees)
  receipt             Json? // { transactionHash? }
  refundDetails       Json? // RefundDetails when cancelled
  failedReason        String?
  lpReference         String? // Legacy Palremit reference (mirror of txnRef for fiat withdrawal when applicable)
  runReference        String? // Partner's run / batch reference; echoed on the offramp and its webhooks
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([runReference])
}

// --- Ramp quotes (POST /offramps/quotes, POST /onramps/quotes) ---

enum RampQuoteTypeEnum {
  offramp
  onramp
}

model RampQuote {
  id         String            @id @default(uuid())
  rampType   RampQuoteTypeEnum
  /**
   * Frozen quote snapshot consumed by POST /offramps or POST /onramps.
   */
  payload    Json
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([expiresAt])
  @@index([rampType, consumedAt])
}

// --- Feature 7: Transaction Limits & High-Value Requests (spec §6) ---

enum HighValueRequestStatusEnum {
  pending
  under_review
  approved
  rejected
}

model HighValueRequest {
  id             String                     @id @default(uuid())
  requestId      String                     @unique // idempotency
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         HighValueRequestStatusEnum @default(pending)
  currency       String?
  requestedLimit String?
  reason         String?
  reviewedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// Partner/API keys: min 32 chars per spec; store hash only; support sandbox/production and rotation.
model ApiKey {
  id          String   @id @default(uuid())
  keyHash     String   @unique // SHA-256 of the raw key; never store plaintext
  keyPrefix   String // First 8 chars for display/logging (e.g. "blxfi_ab")
  partnerId   String // Client/partner identifier
  environment String // "sandbox" | "production"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([keyHash, isActive])
}

// --- Admin dashboard: manual transaction status changes (audit trail) ---
// Written by the no-auth internal ops dashboard. See docs/superpowers/specs/2026-06-15-bloxfi-admin-dashboard-design.md
model AdminAction {
  id         String   @id @default(uuid())
  txnType    String // "onramp" | "offramp"
  txnId      String
  fromStatus String
  toStatus   String
  note       String?  @db.Text
  actor      String? // free-form name typed in the UI (optional; no auth)
  createdAt  DateTime @default(now())

  @@index([txnType, txnId])
  @@index([createdAt])
}

/**
 * Ops-editable sender / payee name per (ramp type, currency, rail).
 * Resolved onto a transfer when it is created; later edits never touch
 * existing rows. rail '' (not NULL) means "any rail" so the unique key works.
 */
model SenderInfoSetting {
  id         String   @id @default(uuid())
  rampType   String // "onramp" | "offramp"
  currency   String // upper-case, e.g. "NGN"
  rail       String   @default("") // lower-case rail, '' = any rail
  senderName String
  updatedBy  String? // free-form name typed in the dashboard (optional; no auth)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([rampType, currency, rail])
}

/// Ops-editable bloxfi FX spread on the currency-api marketRate, one row per
/// (fiat, side). buy = onramp (fiat → crypto), sell = offramp (crypto → fiat).
/// Loaded into memory by core/quotes/pairMarkupStore.ts.
model PairMarkupSetting {
  id                  String   @id @default(uuid())
  fiat                String // upper-case, e.g. "EUR"
  side                String // "buy" | "sell"
  cryptos             String // comma-separated upper-case codes, e.g. "USD,USDT,USDC"
  markupBps           Float // 20 = 0.20%
  /// Offramp (sell) rows: refuse to quote without the payout provider's live executable rate.
  requireProviderRate Boolean  @default(true)
  updatedBy           String? // free-form name typed in the dashboard
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Several rows per (fiat, side) are allowed, one per group of coins, e.g.
  // USD sell: USDT 25 bps and USDC 20 bps. No coin may be in two rows for the
  // same (fiat, side); core/admin/pairMarkup.ts enforces that under a lock.
  @@index([fiat, side])
}

// --- Business wallets (19 Nov 2026) ---
// A business holds USDT / USDC with us, funded on-chain to its own deposit
// addresses, spent on offramps and withdrawals. The balance is the sum of an
// append-only double-entry ledger (WalletJournal + WalletLedgerEntry);
// WalletBalance is a cache updated only in the same DB transaction as a
// journal. Database triggers (see the migration) refuse UPDATE/DELETE on
// ledger rows and any journal whose postings do not sum to zero; CHECKs keep
// balances from going negative. All writes go through
// src/db/repositories/businessWallet.repo.ts.

/// Per-business switches. Off for every business until an admin enables it.
model BusinessWallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  enabled           Boolean  @default(false)
  /// Offramps must be wallet-funded (the per-offramp deposit flow is refused).
  walletOnly        Boolean  @default(false)
  /// Only deposits from a whitelisted sender are credited.
  whitelistRequired Boolean  @default(false)
  /// Debits paused by an admin (offramps and withdrawals refused). Credits still post.
  debitsPaused      Boolean  @default(false)
  pausedReason      String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// One deposit address per business, asset and chain (orchestrator provisioned account).
model WalletDepositAddress {
  id                   String   @id @default(uuid())
  userId               String
  asset                String // USDT | USDC
  chain                String // orchestrator network code, e.g. TRC20, ERC20
  address              String?
  memo                 String?
  provisionedAccountId String?  @unique
  clientReference      String // WAL-<userId>
  /// active | pending | failed | disabled
  status               String   @default("pending")
  failureReason        String?
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, asset, chain])
  @@index([address])
}

/// Addresses a business may fund from, per chain. Admin-managed.
model WalletWhitelistAddress {
  id        String    @id @default(uuid())
  userId    String
  chain     String
  /// Normalized: lower-case for EVM, as-is (base58) for Tron.
  address   String
  label     String?
  addedBy   String
  reason    String?
  createdAt DateTime  @default(now())
  removedAt DateTime?
  removedBy String?

  @@index([userId, chain])
}

/// Cached balance per business and asset. Never written outside a journal post.
model WalletBalance {
  userId    String
  asset     String
  available Decimal  @default(0) @db.Decimal(38, 18)
  reserved  Decimal  @default(0) @db.Decimal(38, 18)
  updatedAt DateTime @updatedAt

  @@id([userId, asset])
}

/// One money movement. idempotencyKey is unique: a retry or a replayed
/// webhook can never post twice.
model WalletJournal {
  id             String              @id @default(uuid())
  idempotencyKey String              @unique
  userId         String
  asset          String
  /// deposit_credit | offramp_reserve | offramp_release | offramp_settle |
  /// offramp_refund | withdrawal_reserve | withdrawal_release |
  /// withdrawal_settle | adjustment
  type           String
  amount         Decimal             @db.Decimal(38, 18)
  refType        String? // deposit | offramp | withdrawal | adjustment
  refId          String?
  actor          String // "system" or the admin's name
  note           String?
  createdAt      DateTime            @default(now())
  entries        WalletLedgerEntry[]

  @@index([userId, asset, createdAt])
  @@index([refType, refId])
}

/// Postings of a journal. account: available | reserved (the business's
/// money) or a contra account (external:deposit, external:offramp,
/// external:withdrawal, adjustment). Signed amounts; each journal sums to 0.
model WalletLedgerEntry {
  id        String        @id @default(uuid())
  journalId String
  journal   WalletJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  userId    String
  asset     String
  account   String
  amount    Decimal       @db.Decimal(38, 18)
  createdAt DateTime      @default(now())

  @@index([userId, asset, account])
  @@index([journalId])
}

/// Every deposit seen on a wallet address, credited or quarantined.
model WalletDeposit {
  id                    String    @id @default(uuid())
  /// Orchestrator deposit id: one row per on-chain deposit.
  orchestratorDepositId String    @unique
  userId                String
  asset                 String
  chain                 String
  amount                Decimal   @db.Decimal(38, 18)
  address               String
  senderAddress         String?
  txId                  String?
  /// credited | quarantined | credited_by_admin | refund_pending | refunded
  status                String
  quarantineReason      String?
  journalId             String?
  resolvedBy            String?
  resolvedAt            DateTime?
  resolutionNote        String?
  rawPayload            Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

/// Withdrawal from a wallet to a whitelisted address. Needs admin approval.
model WalletWithdrawal {
  id                       String    @id @default(uuid())
  requestId                String    @unique
  /// Orchestrator client_reference: WALWD-<24 hex>
  txnRef                   String    @unique
  userId                   String
  asset                    String
  chain                    String
  amount                   Decimal   @db.Decimal(38, 18)
  address                  String
  memo                     String?
  /// pending_approval | approved | submitted | completed | failed | rejected
  status                   String
  orchestratorWithdrawalId String?
  txHash                   String?
  failureReason            String?
  approvedBy               String?
  approvedAt               DateTime?
  rejectedBy               String?
  rejectedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}
