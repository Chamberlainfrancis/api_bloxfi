// BloxFi API — Prisma schema
// Phase 0: minimal schema; models added in feature phases.
//
// Connection URL is configured in prisma.config.ts (root). Run Prisma commands from project root.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Placeholder for Phase 0; real models added in Feature 1+
model SchemaVersion {
  id String @id @default(uuid())
}

// Inbound LP webhooks audit (POST /api/v1/webhooks). Purged after retention (see webhookRetention job).
model WebhookInboundLog {
  id           String   @id @default(uuid())
  receivedAt   DateTime @default(now())
  /**
   * Truncated raw JSON body for storage caps.
   */
  rawBody      String   @db.Text
  /**
   * invalid_buffer | bad_signature | bad_json | bad_schema | processed | handler_error
   */
  outcome      String
  eventType    String?
  eventId      String?
  payload      Json?
  errorMessage String?  @db.Text

  @@index([receivedAt])
}

/** First-seen idempotency key per inbound webhook delivery (Palremit may retry). */
model WebhookDedupe {
  id         String   @id @default(uuid())
  provider   String
  dedupeKey  String   @unique
  createdAt  DateTime @default(now())
}

// --- Feature 1: User Creation & KYB (spec §1) ---

enum UserStatus {
  active
  inactive
  suspended
}

enum KYBStatusEnum {
  not_started
  incomplete
  under_review
  approved
  rejected
  suspended
}

model User {
  id                    String        @id @default(uuid())
  type                  String        @default("business")
  status                UserStatus    @default(active)
  businessInfo          Json // BusinessInfo shape; unique normalized email also enforced via DB indexes (see migrations)
  registeredAddress     Json // Address shape
  legalRepresentative   Json // LegalRepresentative shape
  metadata              Json?
  /**
   * Palremit Liquidity `channel_user_id` from §5.1; reused for §5.2 addresses (offramp).
   */
  palremitChannelUserId String?
  /**
   * POST /users idempotency key (requestId header).
   */
  creationRequestId     String?       @unique
  /**
   * Normalized businessInfo.email: lower(trim). Unique at DB + app layer.
   */
  businessEmailNorm     String?       @unique
  kybStatus             KYBStatusEnum @default(not_started)
  approvedRails         String[]      @default([])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  kybInfo           KybInfo?
  kybSubmissions    KybSubmission[]
  kybRailStatuses   KybRailStatus[]
  kybDocuments      KybDocument[]
  externalWallets   ExternalWallet[]
  accounts          Account[]
  onramps           Onramp[]
  offramps          Offramp[]
  highValueRequests HighValueRequest[]
  onrampBeneficiaries OnrampBeneficiary[]
}

model KybInfo {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessDetails  Json? // BusinessDetails shape
  beneficialOwners Json? // BeneficialOwner[] shape
  directors        Json? // Director[] shape
  updatedAt        DateTime @updatedAt
}

model KybSubmission {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rails                   String[] // e.g. ["USD", "EUR", "GBP"]
  priority                String? // e.g. "standard"
  status                  String // e.g. "under_review"
  submittedAt             DateTime  @default(now())
  estimatedCompletionDate DateTime?

  @@index([userId])
}

model KybRailStatus {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rail         String // e.g. "USD", "EUR"
  status       String // approved, under_review, etc.
  approvedAt   DateTime?
  submittedAt  DateTime?
  capabilities String[]  @default([]) // e.g. ["onramp", "offramp"]

  @@unique([userId, rail])
  @@index([userId])
}

// --- Feature 2: File Upload & KYB Documents (spec §1.4, §1.5) ---

model File {
  id          String   @id @default(uuid())
  filename    String // original filename
  size        Int // bytes
  mimeType    String // application/pdf, image/jpeg, image/png
  storagePath String // S3 object key (e.g. uploads/uuid_filename.pdf)
  uploadedAt  DateTime @default(now())

  kybDocuments KybDocument[]
}

model KybDocument {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  type       String // CERTIFICATE_OF_INCORPORATION, DIRECTOR_ID, etc.
  subType    String? // e.g. PASSPORT for DIRECTOR_ID
  status     String   @default("pending_review") // pending_review, approved, rejected
  metadata   Json? // issuedCountry, issueDate, expiryDate, documentNumber, ownerName
  uploadedAt DateTime @default(now())

  @@index([userId])
  @@index([fileId])
}

// --- Feature 3: External Wallets (spec §2) ---

model ExternalWallet {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String // blockchain address
  /** Optional chain-specific tag / memo (e.g. XRP destination tag) for withdrawals. */
  memo        String?
  /**
   * Chain/network label provided by client (string). Do not validate against DB; validate at LP boundary.
   */
  chain       String
  name        String
  referenceId String // client reference for idempotency/correlation
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? // null until first update

  @@unique([userId, address, chain])
  @@index([userId])
  @@index([userId, createdAt])
}

// --- Feature 4: Accounts / Fiat (spec §3) ---

model Account {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  railType       String // offramp for API-created payout accounts
  currency       String
  paymentRail    String // corridor destinationType (local_bank, wire, etc.)
  accountType    String // free-form corridor label
  accountHolder  Json // AccountHolder shape
  /** Palremit corridor + canonical destination; API `details` is derived from this at read time. */
  providerPayout Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, railType])
  @@index([userId, accountType])
  @@index([userId, currency])
  @@index([userId, createdAt])
}

// --- Feature 5: Onramp (spec §4) ---

enum OnrampStatusEnum {
  CREATED
  AWAITING_FUNDS
  FIAT_PENDING
  FIAT_PROCESSED
  CRYPTO_INITIATED
  CRYPTO_PENDING
  COMPLETED
  FIAT_FAILED
  FIAT_RETURNED
  CRYPTO_FAILED
  EXPIRED
}

model Onramp {
  id               String           @id @default(uuid())
  requestId        String           @unique // idempotency
  /** BloxFi primary transaction id (ON-…); sent to Palremit; echoed as webhook data.txnRef */
  txnRef           String?          @unique
  /** Palremit / channel identifiers for audit (fiat deposit id, withdrawal ref, etc.) */
  providerRefs     Json?
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           OnrampStatusEnum @default(CREATED)
  source           Json // OnrampSource shape
  destination      Json // OnrampDestination shape
  quoteInformation Json // QuoteInformation shape
  depositInfo      Json? // DepositInfo shape (when CREATED)
  receipt          Json? // Receipt shape (when COMPLETED)
  fees             Json? // OnrampFees shape
  profit           Json? // PalremitProfit shape — rate-spread profit (separate from fees)
  developerFee     Json? // legacy { amount, currency } — prefer fees.platformFee
  failedReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

// --- Feature 6: Offramp (spec §5) ---

enum OfframpStatusEnum {
  CREATED
  AWAITING_CRYPTO
  CRYPTO_PENDING
  CRYPTO_RECEIVED
  CRYPTO_CONFIRMED
  PROCESSING_FEE
  FEE_PROCESSED
  FIAT_INITIATED
  FIAT_PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  CRYPTO_FAILED
  FIAT_FAILED
  EXPIRED
}

model Offramp {
  id                  String            @id @default(uuid())
  requestId           String            @unique // idempotency
  /** BloxFi primary transaction id (OFF-…); Palremit fiat withdrawal reference; echoed as webhook data.txnRef */
  txnRef              String?           @unique
  /** Palremit / channel identifiers for audit */
  providerRefs        Json?
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              OfframpStatusEnum @default(CREATED)
  source              Json // OfframpSource shape (crypto)
  destination         Json // OfframpDestination shape (fiat)
  rateInformation     Json // RateInformation shape
  depositInstructions Json? // DepositInstructions (where to send crypto)
  timeline            Json? // Timeline shape
  fees                Json? // OfframpFees shape
  profit              Json? // PalremitProfit shape — rate-spread profit (separate from fees)
  receipt             Json? // { transactionHash? }
  refundDetails       Json? // RefundDetails when cancelled
  failedReason        String?
  lpReference         String? // Legacy Palremit reference (mirror of txnRef for fiat withdrawal when applicable)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

// --- Ramp quotes (POST /offramps/quotes, POST /onramps/quotes) ---

enum RampQuoteTypeEnum {
  offramp
  onramp
}

model RampQuote {
  id          String           @id @default(uuid())
  rampType    RampQuoteTypeEnum
  /** Frozen quote snapshot consumed by POST /offramps or POST /onramps. */
  payload     Json
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([expiresAt])
  @@index([rampType, consumedAt])
}

// --- Feature 7: Transaction Limits & High-Value Requests (spec §6) ---

enum HighValueRequestStatusEnum {
  pending
  under_review
  approved
  rejected
}

model HighValueRequest {
  id             String                     @id @default(uuid())
  requestId      String                     @unique // idempotency
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         HighValueRequestStatusEnum @default(pending)
  currency       String?
  requestedLimit String?
  reason         String?
  reviewedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// --- Onramp beneficiaries (SwipeLux Sumsub share-token KYC import) ---

enum OnrampBeneficiaryStatus {
  pending_import
  approved
  rejected
  failed
}

model OnrampBeneficiary {
  id                 String                  @id @default(uuid())
  businessUserId     String
  businessUser       User                    @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  status             OnrampBeneficiaryStatus @default(pending_import)
  swipeluxCustomerId String?
  email              String
  firstName          String
  lastName           String
  phone              String
  identitySnapshot   Json?
  creationRequestId  String                  @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([businessUserId])
}

// Partner/API keys: min 32 chars per spec; store hash only; support sandbox/production and rotation.
model ApiKey {
  id          String   @id @default(uuid())
  keyHash     String   @unique // SHA-256 of the raw key; never store plaintext
  keyPrefix   String // First 8 chars for display/logging (e.g. "blxfi_ab")
  partnerId   String // Client/partner identifier
  environment String // "sandbox" | "production"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([keyHash, isActive])
}

// --- Admin dashboard: manual transaction status changes (audit trail) ---
// Written by the no-auth internal ops dashboard. See docs/superpowers/specs/2026-06-15-bloxfi-admin-dashboard-design.md
model AdminAction {
  id         String   @id @default(uuid())
  txnType    String // "onramp" | "offramp"
  txnId      String
  fromStatus String
  toStatus   String
  note       String?  @db.Text
  actor      String? // free-form name typed in the UI (optional; no auth)
  createdAt  DateTime @default(now())

  @@index([txnType, txnId])
  @@index([createdAt])
}
