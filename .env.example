# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bloxfi?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# Auth
API_KEY=your-api-bearer-secret
API_KEY_HEADER=Authorization

# Optional: CORS allowed origins (comma-separated; empty = use default)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Rate limit: requests per window per key
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Idempotency: TTL for requestId in Redis (seconds)
IDEMPOTENCY_TTL_SECONDS=86400

# Optional: S3-compatible storage (e.g. for file uploads)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=auto
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Palremit (palremit_rates_guide.md for currency rates)
# Liquidity Orchestrator: https://liquidity.palremit.com — Bearer secret, /v1/* deposits & withdrawals.
# Optional; defaults to production orchestrator URL when unset.
# PALREMIT_LIQUIDITY_URL=https://liquidity.palremit.com
PALREMIT_LIQUIDITY_SECRET=your_one_time_secret_from_tenant_signup
# This bloxfi instance's own tenant_id on the orchestrator — needed only for
# the admin business-provider-customer proxy (/dashboard/api/businesses/...).
PALREMIT_LIQUIDITY_TENANT_ID=
PALREMIT_CURRENCY_URL=https://currency-api.palremit.com
# HMAC secret for inbound orchestrator webhooks (X-Webhook-Signature)
WEBHOOK_SECRET=your-webhook-signing-secret

# Outbound partner webhooks (optional). Unset URL = do not send.
# PARTNER_WEBHOOK_URL=https://partner.example/webhooks
# PARTNER_WEBHOOK_SECRET=at-least-16-chars
